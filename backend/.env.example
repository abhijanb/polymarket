# PostgreSQL connection string — Bun auto-loads .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polymarket?schema=public"
JWT_SECRET="super-secret-change-me-32chars"
JWT_EXPIRES_IN="7d"

# Seeded ADMIN (login-only, not via /api/auth/register)
ADMIN_EMAIL="admin@polymarket.local"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Admin"
